# ==============================================================================
# Veritabanı Yapılandırma Şablonu (.env.example)
# Bu dosyayı .env olarak kopyalayıp kendi şifrenizi giriniz.
# ==============================================================================
DB_TYPE=sqlite

# PostgreSQL ile çalışmak için:
# DB_TYPE=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=proje_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password_here
